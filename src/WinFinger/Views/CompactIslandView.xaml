<UserControl x:Class="WinFinger.Views.CompactIslandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinFinger.Controls">
    <!-- mac NotchCompactView (no hardware notch): [media / pomodoro] [↑↓ metric stack] … [memory ring] -->
    <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- media (cover + spectrum) or pomodoro countdown -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <Grid x:Name="MediaSlot" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="CoverSlot" Width="18" Height="18" CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#38DBC7" Offset="0"/>
                                <GradientStop Color="#4D9EFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect x:Name="CoverGlow" Color="#3D8AFF" BlurRadius="5" ShadowDepth="0" Opacity="0.8"/>
                        </Border.Effect>
                        <Grid>
                            <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="9" Text="&#xE8D6;" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="5">
                                <Border.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border Width="18" Height="18" CornerRadius="5" Background="Black"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.OpacityMask>
                                <Image x:Name="CoverImage" Stretch="UniformToFill" Width="18" Height="18"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- audio bars (real FFT, 5 capsules 2px wide / 2px gap, accent @0.95 — mac AudioBars look) -->
                    <StackPanel x:Name="SpectrumPanel" Orientation="Horizontal" Height="14" Width="22"
                                VerticalAlignment="Center" Margin="5,0,0,0">
                        <Rectangle Width="2" RadiusX="1" RadiusY="1" Margin="0,0,2,0" VerticalAlignment="Bottom" Height="5"/>
                        <Rectangle Width="2" RadiusX="1" RadiusY="1" Margin="0,0,2,0" VerticalAlignment="Bottom" Height="10"/>
                        <Rectangle Width="2" RadiusX="1" RadiusY="1" Margin="0,0,2,0" VerticalAlignment="Bottom" Height="7"/>
                        <Rectangle Width="2" RadiusX="1" RadiusY="1" Margin="0,0,2,0" VerticalAlignment="Bottom" Height="11"/>
                        <Rectangle Width="2" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" Height="6"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- pomodoro (mac PomodoroCompactView: timer / cup icon + time) -->
            <StackPanel x:Name="PomodoroSlot" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="PomodoroGlyph" FontFamily="{StaticResource Font.Icon}" FontSize="9" Text="&#xE823;"
                           Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                <TextBlock x:Name="PomodoroLabel" FontFamily="{StaticResource Font.Mono}" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Warning}" Margin="4,0,0,0" VerticalAlignment="Center" Text="25:00"/>
            </StackPanel>
        </StackPanel>

        <!-- metric stack (two lines) -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="7" FontWeight="SemiBold" Text="&#xE74A;" Width="9"
                           Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                <TextBlock x:Name="UploadLabel" FontFamily="{StaticResource Font.Mono}" FontSize="8.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Upload}" Margin="4,0,0,0" VerticalAlignment="Center" Text="0 B/s"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="7" FontWeight="SemiBold" Text="&#xE74B;" Width="9"
                           Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                <TextBlock x:Name="DownloadLabel" FontFamily="{StaticResource Font.Mono}" FontSize="8.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Download}" Margin="4,0,0,0" VerticalAlignment="Center" Text="0 B/s"/>
            </StackPanel>
        </StackPanel>

        <!-- hover-revealed title (Windows extra) -->
        <TextBlock x:Name="HoverTitleLabel" Grid.Column="2" Style="{StaticResource Text.Micro}"
                   Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="10,0" MaxWidth="180" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Opacity="0" Text=""/>

        <!-- memory ring -->
        <controls:MemoryRing x:Name="Ring" Grid.Column="3" Width="22" Height="22" VerticalAlignment="Center" Margin="10,0,0,0"/>
    </Grid>
</UserControl>
