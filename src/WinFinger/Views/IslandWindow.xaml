<Window x:Class="WinFinger.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinFinger.Views"
        Title="WinFinger"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="980" Height="620"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- The window is a fixed transparent stage; only IslandBorder animates. -->
    <Grid>
        <Border x:Name="IslandBorder"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,8,0,0"
                Width="300" Height="36"
                CornerRadius="18"
                Background="#01000000"
                BorderBrush="{DynamicResource Brush.GlassRim}"
                BorderThickness="1.2"
                Cursor="Hand"
                MouseLeftButtonDown="OnIslandMouseDown"
                MouseLeftButtonUp="OnIslandClicked"
                MouseMove="OnIslandMouseMove"
                MouseEnter="OnIslandMouseEnter"
                MouseLeave="OnIslandMouseLeave">
            <Border.Effect>
                <DropShadowEffect x:Name="IslandShadow" Color="#000000" BlurRadius="32" ShadowDepth="6" Direction="270" Opacity="0.35"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- live frosted glass: blurred + saturation-boosted capture of what's behind -->
                <Border x:Name="GlassLayer" IsHitTestVisible="False"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}"
                        RenderOptions.BitmapScalingMode="Fant">
                    <Border.Background>
                        <ImageBrush x:Name="GlassBrush" Stretch="Fill"/>
                    </Border.Background>
                </Border>

                <!-- image dim: darkens a custom background image for legibility -->
                <Border x:Name="ImageDimLayer" IsHitTestVisible="False" Background="#000000" Opacity="0"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}"/>

                <!-- smoked glass body tint (opacity = user's 玻璃暗度) -->
                <Border x:Name="BodyTintLayer" IsHitTestVisible="False" Opacity="1"
                        Background="{DynamicResource Brush.IslandBody}"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}"/>

                <!-- adaptive tint: album accent bleeds into the glass while music plays -->
                <Border x:Name="TintLayer" IsHitTestVisible="False" Opacity="0"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}">
                    <Border.Background>
                        <SolidColorBrush x:Name="TintBrush" Color="#000000"/>
                    </Border.Background>
                </Border>

                <!-- curved top reflection: scales with the island, fades out by ~45% height -->
                <Border Background="{DynamicResource Brush.TopSheen}"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False"/>

                <views:CompactIslandView x:Name="CompactView"/>

                <!-- expanded panel laid out at the mac design size and scaled to the island -->
                <views:ExpandedPanelView x:Name="ExpandedView" Opacity="0" Visibility="Collapsed"
                                         Width="920" Height="520" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <!-- transient notification bulge -->
                <Grid x:Name="NotificationView" Opacity="0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="NotificationIcon" FontSize="13" VerticalAlignment="Center" Text="📋"/>
                        <TextBlock x:Name="NotificationText" Style="{StaticResource Text.Body}" FontSize="12"
                                   Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="340"
                                   TextTrimming="CharacterEllipsis" Text=""/>
                    </StackPanel>
                </Grid>

                <!-- inner dark edge: glass thickness -->
                <Border Margin="1" BorderThickness="1" BorderBrush="{DynamicResource Brush.GlassInnerEdge}"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False"/>

                <!-- chromatic dispersion along the bevel -->
                <Border x:Name="ChromaticLayer" Margin="1.4" BorderThickness="1" BorderBrush="{DynamicResource Brush.ChromaticEdge}"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False"/>

                <!-- breathing glints: light slowly travels between the two edges -->
                <Border x:Name="GlintA" BorderThickness="1.4" BorderBrush="{DynamicResource Brush.GlintTopLeft}"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False" Opacity="0.2"/>
                <Border x:Name="GlintB" BorderThickness="1.4" BorderBrush="{DynamicResource Brush.GlintBottomRight}"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False" Opacity="0.9"/>

                <!-- breathing accent border while expanded (mac BreathingBorder) -->
                <Border x:Name="AccentBorder" BorderThickness="1.5" IsHitTestVisible="False" Opacity="0"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}">
                    <Border.BorderBrush>
                        <LinearGradientBrush x:Name="AccentBorderBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="AccentStop0" Color="#2038DBC7" Offset="0"/>
                            <GradientStop x:Name="AccentStop1" Color="#E038DBC7" Offset="0.45"/>
                            <GradientStop Color="#B8FFFFFF" Offset="0.6"/>
                            <GradientStop x:Name="AccentStop2" Color="#7038DBC7" Offset="0.8"/>
                            <GradientStop x:Name="AccentStop3" Color="#2038DBC7" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <!-- sheen band swept across on expand / notification -->
                <Border x:Name="SheenBand" Width="150" HorizontalAlignment="Left" Opacity="0"
                        Background="{DynamicResource Brush.SheenSweep}" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleX="-18"/>
                            <TranslateTransform x:Name="SheenTranslate" X="-200"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>

                <!-- corner resize handles (mac PanelResizeHandle), expanded only -->
                <Border x:Name="ResizeLeft" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Background="Transparent" Cursor="SizeNESW" Visibility="Collapsed" ToolTip="拖动调整面板大小"
                        MouseLeftButtonDown="OnResizeDown" MouseMove="OnResizeMove" MouseLeftButtonUp="OnResizeUp"/>
                <Border x:Name="ResizeRight" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="Transparent" Cursor="SizeNWSE" Visibility="Collapsed" ToolTip="拖动调整面板大小"
                        MouseLeftButtonDown="OnResizeDown" MouseMove="OnResizeMove" MouseLeftButtonUp="OnResizeUp"/>
            </Grid>
        </Border>
    </Grid>
</Window>
