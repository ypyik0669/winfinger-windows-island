<UserControl x:Class="WinFinger.Views.ExpandedPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinFinger.Controls">
    <!-- Laid out at the mac design size (920×520) and scaled by the window (mac scaleEffect). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header (mac ExpandedPanelView.header): brand · tabs · drag region · lock · metrics -->
        <Grid Grid.Row="0" Margin="18,12,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- brand button: collapses -->
            <Button x:Name="BrandButton" Grid.Column="0" Style="{StaticResource Button.Ghost}" Padding="6,0" Height="32"
                    ToolTip="收起 WinFinger">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Teal}" VerticalAlignment="Center"/>
                    <TextBlock FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource Font.Text}"
                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="7,0,0,0" VerticalAlignment="Center" Text="WinFinger"/>
                </StackPanel>
            </Button>

            <!-- page tabs -->
            <Border Grid.Column="1" Background="{DynamicResource Brush.Fill}" CornerRadius="17" Padding="3" Margin="16,0,0,0" VerticalAlignment="Center">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
            </Border>

            <!-- drag / tap-to-collapse region -->
            <Border x:Name="DragRegion" Grid.Column="2" Background="Transparent" Height="32" Cursor="SizeAll"
                    ToolTip="按住拖出面板，轻点可收起"/>

            <!-- lock -->
            <Button x:Name="PinButton" Grid.Column="3" Style="{StaticResource Button.Icon}" Width="28" Height="28" FontSize="11"
                    Background="{DynamicResource Brush.Fill}" ToolTip="锁定后点击外部不会收起">
                <Grid>
                    <Ellipse x:Name="PinRing" Stroke="{DynamicResource Brush.Hairline}" StrokeThickness="0.8" Width="28" Height="28" Opacity="0.7"/>
                    <TextBlock x:Name="PinGlyph" FontFamily="{StaticResource Font.Icon}" FontSize="11" Text="&#xE785;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- metrics: ↑ ↓ ring -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="8" FontWeight="Bold" Text="&#xE74A;"
                               Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UploadLabel" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Upload}" Margin="4,0,0,0" VerticalAlignment="Center" Text="0 B/s"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="8" FontWeight="Bold" Text="&#xE74B;"
                               Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DownloadLabel" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Download}" Margin="4,0,0,0" VerticalAlignment="Center" Text="0 B/s"/>
                </StackPanel>
                <controls:MemoryRing x:Name="HeaderRing" Width="30" Height="30" Margin="12,0,0,0" Cursor="Hand"
                                     ToolTip="打开任务管理器" MouseLeftButtonUp="OnRingClicked"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Border}"/>

        <!-- page host -->
        <ContentControl x:Name="PageHost" Grid.Row="2"/>
    </Grid>
</UserControl>
