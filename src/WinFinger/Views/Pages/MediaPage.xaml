<UserControl x:Class="WinFinger.Views.Pages.MediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinFinger.Controls">
    <UserControl.Resources>
        <!-- artwork with breathing accent glow behind it (mac artwork(compact:)) -->
        <Style x:Key="ArtworkFrame" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        </Style>
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Fill}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Icon}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- no session -->
        <StackPanel x:Name="EmptyPane" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="34" FontWeight="Light" Foreground="{DynamicResource Brush.Teal}"
                       HorizontalAlignment="Center" Text="&#xE8D6;"/>
            <TextBlock FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource Font.Text}"
                       Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" Margin="0,12,0,0" Text="没有正在播放的音乐"/>
            <TextBlock FontSize="11" FontFamily="{StaticResource Font.Text}" Foreground="{DynamicResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" Margin="0,12,0,0" Text="支持网易云音乐、Spotify、QQ音乐以及浏览器等系统媒体"/>
        </StackPanel>

        <!-- player layout: [artwork 244] [42] [info ≤430]; switches to [info 280] [36] [lyrics] when lyrics are ready -->
        <Grid x:Name="PlayerPane" Visibility="Collapsed" Margin="28,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="Auto"/>
                <ColumnDefinition x:Name="GapColumn" Width="42"/>
                <ColumnDefinition x:Name="RightColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- big artwork (player layout only) -->
            <Grid x:Name="ArtworkBox" Grid.Column="0" Width="244" Height="244" VerticalAlignment="Center">
                <Border x:Name="ArtworkGlow" Width="232" Height="232" CornerRadius="30" Opacity="0.28" RenderTransformOrigin="0.5,0.5">
                    <Border.Background>
                        <LinearGradientBrush x:Name="GlowBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="GlowStop0" Color="#3D8AFF" Offset="0"/>
                            <GradientStop x:Name="GlowStop1" Color="#3D8AFF" Offset="0.35"/>
                            <GradientStop Color="#DBFFFFFF" Offset="0.55"/>
                            <GradientStop x:Name="GlowStop2" Color="#3D8AFF" Offset="0.8"/>
                            <GradientStop x:Name="GlowStop3" Color="#3D8AFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <BlurEffect x:Name="GlowBlur" Radius="11"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="GlowScale" ScaleX="0.98" ScaleY="0.98"/>
                            <RotateTransform x:Name="GlowRotate" Angle="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
                <Border x:Name="ArtworkFrame" Style="{StaticResource ArtworkFrame}" Width="204" Height="204">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="10" Direction="270" Opacity="0.38"/>
                    </Border.Effect>
                    <Grid>
                        <Border x:Name="ArtworkPlaceholder" CornerRadius="24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#38DBC7" Offset="0"/>
                                    <GradientStop Color="#4D9EFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="48" Text="&#xE8D6;" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="ArtworkClip" CornerRadius="24">
                            <Border.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Border Width="{Binding ActualWidth, ElementName=ArtworkClip}" Height="{Binding ActualHeight, ElementName=ArtworkClip}"
                                                CornerRadius="24" Background="Black"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.OpacityMask>
                            <Image x:Name="ArtworkImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- info column -->
            <StackPanel x:Name="InfoColumn" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="430">
                <!-- compact artwork (lyrics layout only) -->
                <Grid x:Name="CompactArtworkBox" Width="220" Height="220" HorizontalAlignment="Left" Visibility="Collapsed">
                    <Border x:Name="CompactGlow" Width="210" Height="210" CornerRadius="30" Opacity="0.28" RenderTransformOrigin="0.5,0.5"
                            Background="{Binding Background, ElementName=ArtworkGlow}">
                        <Border.Effect>
                            <BlurEffect x:Name="CompactGlowBlur" Radius="11"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CompactGlowScale" ScaleX="0.98" ScaleY="0.98"/>
                                <RotateTransform x:Name="CompactGlowRotate" Angle="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                    <Border x:Name="CompactArtworkFrame" Style="{StaticResource ArtworkFrame}" Width="188" Height="188">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="10" Direction="270" Opacity="0.38"/>
                        </Border.Effect>
                        <Grid>
                            <Border x:Name="CompactPlaceholder" CornerRadius="24">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#38DBC7" Offset="0"/>
                                        <GradientStop Color="#4D9EFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="44" Text="&#xE8D6;" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="CompactClip" CornerRadius="24">
                                <Border.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border Width="{Binding ActualWidth, ElementName=CompactClip}" Height="{Binding ActualHeight, ElementName=CompactClip}"
                                                    CornerRadius="24" Background="Black"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.OpacityMask>
                                <Image x:Name="CompactArtworkImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- status row (player layout only) -->
                <StackPanel x:Name="StatusRow" Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLabel" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource Font.Text}"
                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center" Text="正在播放"/>
                </StackPanel>

                <TextBlock x:Name="TitleLabel" FontSize="27" FontWeight="Bold" FontFamily="{StaticResource Font.Display}"
                           Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,14,0,0" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="76" Text=""/>
                <TextBlock x:Name="SubtitleLabel" FontSize="13" FontWeight="Medium" FontFamily="{StaticResource Font.Text}"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Text=""/>

                <!-- progress -->
                <StackPanel x:Name="ProgressPane" Margin="0,18,0,0">
                    <Grid x:Name="ProgressTrack" Height="4">
                        <Border Background="{DynamicResource Brush.FillStrong}" CornerRadius="2"/>
                        <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="2">
                            <Border.Background>
                                <SolidColorBrush x:Name="ProgressBrush" Color="#3D8AFF"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <TextBlock x:Name="ElapsedLabel" FontSize="9.5" FontWeight="Medium" FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" Text="0:00"/>
                        <TextBlock x:Name="DurationLabel" FontSize="9.5" FontWeight="Medium" FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" Text="0:00"/>
                    </Grid>
                </StackPanel>

                <!-- controls -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="PrevButton" Style="{StaticResource TransportButton}" Content="&#xE892;" ToolTip="上一首"/>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource TransportButton}" Width="54" Height="54" FontSize="20"
                            Margin="18,0" Foreground="#D1000000" ToolTip="播放">
                        <Button.Background>
                            <SolidColorBrush x:Name="PlayBrush" Color="#3D8AFF"/>
                        </Button.Background>
                        <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;"/>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource TransportButton}" Content="&#xE893;" ToolTip="下一首"/>
                </StackPanel>
            </StackPanel>

            <!-- lyrics (lyrics layout only) -->
            <controls:LyricsPane x:Name="Lyrics" Grid.Column="2" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
