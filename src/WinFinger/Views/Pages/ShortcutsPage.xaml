<UserControl x:Class="WinFinger.Views.Pages.ShortcutsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WinFinger.Models">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header: icon · name/status · badge · refresh (mac ShortcutsView.header) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Brush.Surface}" ClipToBounds="True">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,42,42" RadiusX="10" RadiusY="10"/>
                </Border.Clip>
                <Grid>
                    <TextBlock x:Name="AppGlyph" FontFamily="{StaticResource Font.Icon}" FontSize="18" Text="&#xE8FD;"
                               Foreground="{DynamicResource Brush.Teal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="AppIcon" Stretch="Uniform" Margin="6" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="AppNameLabel" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource Font.Text}"
                           Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" Text="当前应用"/>
                <TextBlock x:Name="StatusLabel" FontSize="12" FontFamily="{StaticResource Font.Text}"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="准备读取当前应用快捷键"/>
            </StackPanel>

            <!-- status badge -->
            <Border Grid.Column="2" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Fill}" Padding="10,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="BadgeDot" Width="6" Height="6" Fill="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BadgeLabel" FontSize="10" FontWeight="SemiBold" FontFamily="{StaticResource Font.Text}"
                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center" Text="内置"/>
                </StackPanel>
            </Border>

            <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource Button.Icon}" Width="30" Height="30" Margin="8,0,0,0"
                    Content="&#xE72C;" ToolTip="重新读取当前应用快捷键"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource Scroll.Dark}">
            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ShortcutGroup}">
                        <StackPanel Margin="0,0,6,16">
                            <TextBlock FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Font.Text}"
                                       Foreground="{DynamicResource Brush.Teal}" Text="{Binding Title}" Margin="2,0,0,8"
                                       Typography.Capitals="AllSmallCaps"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ShortcutItem}">
                                        <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" MinHeight="46"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                Padding="10,6" Margin="0,0,8,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="8"
                                                        MinWidth="52" MinHeight="30" Padding="8,0" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Keys}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="Medium" FontFamily="{StaticResource Font.Text}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Action}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
