<UserControl x:Class="WinFinger.Views.Pages.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinFinger.Controls"
             xmlns:models="clr-namespace:WinFinger.Models">
    <UserControl.Resources>
        <controls:BoolToVisibilityConverter x:Key="BoolVisible"/>
        <controls:NotePreviewConverter x:Key="NotePreview"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- left: note list (mac: width 250, padding 16, backgroundTop @0.82) -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock FontSize="14" FontWeight="Bold" FontFamily="{StaticResource Font.Text}"
                               Foreground="{DynamicResource Brush.TextPrimary}" Text="我的便签" VerticalAlignment="Center"/>
                    <Button x:Name="NewButton" Style="{StaticResource Button.Icon}" Width="30" Height="30" HorizontalAlignment="Right"
                            Content="&#xE710;" FontSize="12" ToolTip="新建便签"/>
                </Grid>
                <TextBlock x:Name="ListEmptyHint" Grid.Row="1" FontSize="12" FontFamily="{StaticResource Font.Text}"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,0" Text="还没有便签" Visibility="Collapsed"/>
                <ListBox x:Name="NoteList" Grid.Row="2" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource Scroll.Dark}"/>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="10" Margin="0,0,0,6" Padding="10,7" MinHeight="46">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.Fill}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Note}">
                            <Grid>
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Style="{StaticResource MenuItem.Flat}" Header="置顶" Click="OnContextPin"
                                                  Visibility="{Binding IsPinned, Converter={StaticResource BoolVisible}, ConverterParameter=invert}"/>
                                        <MenuItem Style="{StaticResource MenuItem.Flat}" Header="取消置顶" Click="OnContextPin"
                                                  Visibility="{Binding IsPinned, Converter={StaticResource BoolVisible}}"/>
                                        <MenuItem Style="{StaticResource MenuItem.Flat}" Header="删除" Click="OnContextDelete"
                                                  Foreground="{DynamicResource Brush.Danger}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource Font.Text}"
                                               Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" FontFamily="{StaticResource Font.Text}" Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding Body, Converter={StaticResource NotePreview}}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Icon}" FontSize="9" Text="&#xE840;"
                                           Foreground="{DynamicResource Brush.Teal}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolVisible}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Border}"/>

        <!-- right: editor (mac padding 20) -->
        <Grid Grid.Column="2" Margin="20">
            <Grid x:Name="EditorPane" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid Margin="0,0,40,0">
                        <TextBlock x:Name="TitlePlaceholder" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource Font.Text}"
                                   Foreground="{DynamicResource Brush.TextTertiary}" Text="标题" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="TitleBox" Style="{StaticResource TextBox.Plain}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                    <Button x:Name="PinButton" Style="{StaticResource Button.Icon}" Width="30" Height="30" HorizontalAlignment="Right"
                            VerticalAlignment="Center" ToolTip="置顶便签">
                        <TextBlock x:Name="PinGlyph" FontFamily="{StaticResource Font.Icon}" FontSize="12" Text="&#xE718;"/>
                    </Button>
                </Grid>
                <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,10,0,0"/>
                <TextBox x:Name="BodyBox" Grid.Row="2" Style="{StaticResource TextBox.Plain}" FontSize="14" Margin="0,6,0,6"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         SpellCheck.IsEnabled="False" IsUndoEnabled="True"/>
                <Grid Grid.Row="3">
                    <TextBlock FontSize="10" FontFamily="{StaticResource Font.Text}" Foreground="{DynamicResource Brush.TextSecondary}" Text="自动保存"/>
                    <TextBlock FontSize="10" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.TextSecondary}"
                               HorizontalAlignment="Right" Text="Ctrl+N 新建"/>
                </Grid>
            </Grid>

            <!-- empty editor state -->
            <StackPanel x:Name="EmptyPane" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Teal}"
                           HorizontalAlignment="Center" Text="&#xE70B;"/>
                <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource Font.Text}"
                           Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0" Text="选择或新建一张便签"/>
                <Button x:Name="EmptyNewButton" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Center" Margin="0,10,0,0" Content="新建便签"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
