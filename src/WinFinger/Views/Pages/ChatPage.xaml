<UserControl x:Class="WinFinger.Views.Pages.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinFinger.Controls"
             xmlns:models="clr-namespace:WinFinger.Models">
    <UserControl.Resources>
        <controls:NullToCollapsedConverter x:Key="NullCollapse"/>
        <controls:BoolToVisibilityConverter x:Key="BoolVisible"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：会话列表 -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock FontSize="14" FontWeight="Bold" FontFamily="{StaticResource Font.Text}"
                               Foreground="{DynamicResource Brush.TextPrimary}" Text="对话" VerticalAlignment="Center"/>
                    <Button x:Name="NewButton" Style="{StaticResource Button.Icon}" Width="30" Height="30"
                            HorizontalAlignment="Right" Content="&#xE710;" FontSize="12" ToolTip="新对话（Ctrl+N）"/>
                </Grid>
                <TextBlock x:Name="ListEmptyHint" Grid.Row="1" FontSize="12" FontFamily="{StaticResource Font.Text}"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,0"
                           Text="还没有对话" Visibility="Collapsed"/>
                <ListBox x:Name="SessionList" Grid.Row="2" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource Scroll.Dark}"/>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="10" Margin="0,0,0,6"
                                                Padding="10,7" MinHeight="46">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.Fill}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ChatSession}">
                            <!-- Background 必须给：不给的话空白处不参与命中测试，
                                 只有正好点在标题文字上右键菜单才出得来 -->
                            <Grid Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Style="{StaticResource MenuItem.Flat}" Header="重命名…" Click="OnContextRename"/>
                                        <MenuItem Style="{StaticResource MenuItem.Flat}" Header="删除" Click="OnContextDelete"
                                                  Foreground="{DynamicResource Brush.Danger}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource Font.Text}"
                                               Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" FontFamily="{StaticResource Font.Text}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Preview}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource Brush.Teal}" ToolTip="正在生成"
                                         Visibility="{Binding IsStreaming, Converter={StaticResource BoolVisible}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Border}"/>

        <!-- 右：对话区 -->
        <Grid Grid.Column="2" Margin="16,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SessionTitle" Grid.Column="0" FontSize="13" FontWeight="SemiBold"
                           FontFamily="{StaticResource Font.Text}" Foreground="{DynamicResource Brush.TextPrimary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="新对话"/>
                <TextBox x:Name="TitleEditor" Grid.Column="0" Style="{StaticResource TextBox.Dark}" FontSize="13"
                         VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource Text.Micro}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button x:Name="ModelChip" Grid.Column="2" Style="{StaticResource Button.Secondary}"
                        Margin="10,0,0,0" Content="模型" ToolTip="选择这个会话使用的模型"/>
                <Button x:Name="ModelButton" Grid.Column="3" Style="{StaticResource Button.Icon}" Width="28" Height="28"
                        Margin="6,0,0,0" Content="&#xE713;" FontSize="12" ToolTip="AI 设置"/>
            </Grid>

            <ScrollViewer x:Name="Transcript" Grid.Row="1" Style="{StaticResource Scroll.Dark}" Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessageList" Margin="0,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ChatMessage}">
                            <Grid Margin="0,0,0,10">
                                <Border x:Name="bubble" CornerRadius="12" Padding="12,9" MaxWidth="640"
                                        HorizontalAlignment="Left" Background="Transparent">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Micro}" Margin="0,0,0,4"
                                                   Text="{Binding Source}"
                                                   Visibility="{Binding Source, Converter={StaticResource NullCollapse}}"/>
                                        <TextBox x:Name="plainBody" Text="{Binding Content, Mode=OneWay}"
                                                 IsReadOnly="True" Visibility="Collapsed"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 FontSize="13" FontFamily="{StaticResource Font.Text}"
                                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                                 TextWrapping="Wrap" IsTabStop="False"
                                                 HorizontalScrollBarVisibility="Disabled"/>
                                        <controls:MarkdownView x:Name="richBody"
                                                               Source="{Binding Content, Mode=OneWay}"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="11" FontFamily="{StaticResource Font.Text}"
                                                   Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"
                                                   Text="{Binding Error}"
                                                   Visibility="{Binding Error, Converter={StaticResource NullCollapse}}"/>
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Micro}" Text="已停止"
                                                   Visibility="{Binding Stopped, Converter={StaticResource BoolVisible}}"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="copyButton" Style="{StaticResource Button.Icon}" Width="24" Height="24"
                                        Content="&#xE8C8;" FontSize="11" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Visibility="Collapsed" ToolTip="复制这条"
                                        Click="OnCopyMessage"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="plainBody" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="richBody" Property="Visibility" Value="Collapsed"/>
                                    <!-- 同时把 Source 清空：只藏不清的话，粘进来的几万字用户消息
                                         照样会被解析成一棵永远不显示的 WPF 元素树 -->
                                    <Setter TargetName="richBody" Property="Source" Value=""/>
                                    <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="bubble" Property="MaxWidth" Value="460"/>
                                    <Setter TargetName="bubble" Property="Background"
                                            Value="{DynamicResource Brush.SurfaceElevated}"/>
                                </DataTrigger>
                                <Trigger SourceName="bubble" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="copyButton" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyPane" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="30" Text="&#xE8BD;"
                           Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource Font.Text}"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,10,0,0"
                           HorizontalAlignment="Center" Text="问点什么"/>
                <TextBlock x:Name="EmptySubtitle" Style="{StaticResource Text.Micro}" Margin="0,4,0,0"
                           HorizontalAlignment="Center" Text="内容会用你自己配置的接口发送"/>
                <Button x:Name="ConfigureButton" Style="{StaticResource Button.Primary}" Content="去配置 API Key"
                        Margin="0,14,0,0" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="12" Padding="10,8"
                    Background="{DynamicResource Brush.Fill}" BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Stroke}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBlock x:Name="ComposerPlaceholder" FontSize="13" FontFamily="{StaticResource Font.Text}"
                                   Foreground="{DynamicResource Brush.TextTertiary}" IsHitTestVisible="False"
                                   VerticalAlignment="Top" Text="问点什么…  Enter 发送 · Shift+Enter 换行"/>
                        <TextBox x:Name="Composer" Background="Transparent" BorderThickness="0" Padding="0"
                                 FontSize="13" FontFamily="{StaticResource Font.Text}"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 CaretBrush="{DynamicResource Brush.TextPrimary}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="110"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                    <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource Button.Icon}" Width="32" Height="32"
                            Margin="10,0,0,0" VerticalAlignment="Bottom" Content="&#xE724;" FontSize="14"
                            ToolTip="发送（Enter）"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
