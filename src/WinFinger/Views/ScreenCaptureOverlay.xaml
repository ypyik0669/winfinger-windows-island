<Window x:Class="WinFinger.Views.ScreenCaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="区域截图"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        Focusable="True" Cursor="Cross"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseUp"
        MouseRightButtonDown="OnMouseRightDown">
    <Grid>
        <Image x:Name="Frozen" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <Path x:Name="Mask" Fill="#73000000"/>
        <Canvas x:Name="Layer">
            <Rectangle x:Name="SelectionBorder" Visibility="Collapsed"
                       Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1"
                       SnapsToDevicePixels="True"/>
            <Border x:Name="SizeLabel" Visibility="Collapsed"
                    Background="#CC000000" CornerRadius="4" Padding="6,2">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"
                           FontFamily="{StaticResource Font.Text}"/>
            </Border>
        </Canvas>
        <Border x:Name="Hint" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,28,0,0"
                Background="#CC000000" CornerRadius="8" Padding="14,7">
            <TextBlock Text="拖动选择区域 · Enter 确认 · Esc 取消" Foreground="White" FontSize="13"
                       FontFamily="{StaticResource Font.Text}"/>
        </Border>
    </Grid>
</Window>
