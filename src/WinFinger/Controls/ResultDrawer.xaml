<UserControl x:Class="WinFinger.Controls.ResultDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxHeight="230" Visibility="Collapsed">
    <Border x:Name="Root" Background="{DynamicResource Brush.Card}" CornerRadius="14" Padding="12,10"
            BorderThickness="1" BorderBrush="{DynamicResource Brush.Hairline}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderGlyph" Grid.Column="0" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                           Text="&#xE945;" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"/>
                <TextBlock x:Name="HeaderTitle" Grid.Column="1" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                           FontFamily="{StaticResource Font.Text}" Foreground="{DynamicResource Brush.TextPrimary}"
                           VerticalAlignment="Center" Text="结果"/>
                <TextBlock x:Name="HeaderStatus" Grid.Column="2" Margin="10,0,10,0" FontSize="10"
                           FontFamily="{StaticResource Font.Text}" Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="StopButton" Grid.Column="3" Style="{StaticResource Button.Icon}" Content="&#xE71A;"
                        ToolTip="停止生成" Visibility="Collapsed"/>
                <Button x:Name="CloseButton" Grid.Column="4" Style="{StaticResource Button.Icon}" Content="&#xE711;"
                        ToolTip="关闭 (Esc)" Margin="2,0,0,0"/>
            </Grid>

            <ProgressBar x:Name="StreamBar" Grid.Row="1" Height="2" Margin="0,6,0,0" IsIndeterminate="True"
                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.Accent}"
                         Visibility="Collapsed"/>

            <!-- body -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <TextBox x:Name="TextBody" Style="{StaticResource TextBox.Dark}" IsReadOnly="True" FontSize="12"
                         TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120" MinHeight="44"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Visibility="Collapsed"/>

                <StackPanel x:Name="ImageBody" Orientation="Vertical" Visibility="Collapsed">
                    <Image x:Name="ResultImage" MaxHeight="130" Stretch="Uniform" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="ImageSizeLabel" FontSize="10" Margin="0,4,0,0"
                               FontFamily="{StaticResource Font.Text}" Foreground="{DynamicResource Brush.TextTertiary}"/>
                </StackPanel>

                <StackPanel x:Name="ColorBody" Orientation="Horizontal" Visibility="Collapsed">
                    <Border x:Name="ColorSwatch" Width="48" Height="48" CornerRadius="10" VerticalAlignment="Top"
                            BorderThickness="1" BorderBrush="{DynamicResource Brush.Hairline}"/>
                    <StackPanel Margin="12,0,0,0" x:Name="ColorRows"/>
                </StackPanel>

                <StackPanel x:Name="MessageBody" Orientation="Vertical" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap"
                               FontFamily="{StaticResource Font.Text}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <Button x:Name="MessageCta" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- footer -->
            <WrapPanel x:Name="Footer" Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal"/>
        </Grid>
    </Border>
</UserControl>
